# このファイルを .env にコピーして各値を設定してください
# cp .env.example .env

# =====================
# X (Twitter) API設定
# =====================
# https://developer.twitter.com でアプリを作成して取得
# 無料プランのBearer Tokenで動作します
X_BEARER_TOKEN=your_bearer_token_here

# =====================
# Instagram設定
# =====================
# ChromeでInstagramにログイン後、F12→Application→Cookies→sessionid の Value をコピー
INSTAGRAM_USERNAME=あなたのInstagramユーザー名
INSTAGRAM_SESSION_ID=ブラウザから取得したsessionidの値

# =====================
# メール送信設定（Gmail推奨）
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmailの場合: Googleアカウント > セキュリティ > アプリパスワード で生成
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here

# 通知先メールアドレス（config.yaml の to が空の場合に使用）
NOTIFY_EMAIL=your_notify_address@gmail.com
